# Optional Docker Compose ONLY: admin password for a NEW PostgreSQL volume.
# Copy to ignored .env locally or export this variable in the Compose shell.
# Initialize-Postgres.ps1 creates a separate restricted scala_lab role/database.
POSTGRES_ADMIN_PASSWORD=replace-with-a-local-admin-password
# Native Scala reads PGHOST, PGPORT, PGDATABASE, PGUSER and PGPASSWORD from
# its process environment. It does not automatically load this .env file.
