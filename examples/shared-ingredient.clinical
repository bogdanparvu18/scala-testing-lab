// Fictional software fixture: values follow the demo parser, not clinical dosing.
patient DemoPatient {
  age 30
  condition DemoCondition
}

medication paracetamol {
  1 mg
  route PO
  frequency PRN
}

medication acetaminophen {
  1 mg
  route PO
  frequency PRN
}

plan FirstOrder {
  for DemoPatient
